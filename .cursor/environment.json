{
  "name": "volatile-chat-app",
  "install": "npm install && (cd server && npm install) && (cd client && npm install)",
  "terminals": [
    {
      "name": "server",
      "command": "cd server && node server.js"
    },
    {
      "name": "client",
      "command": "cd client && npm run dev -- --host --port 5173"
    }
  ],
  "ports": [5173, 10000]
}
